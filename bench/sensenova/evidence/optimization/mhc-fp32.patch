diff --git a/ggml/src/ggml-cuda/CMakeLists.txt b/ggml/src/ggml-cuda/CMakeLists.txt
index 297d9ff..dd70734 100644
--- a/ggml/src/ggml-cuda/CMakeLists.txt
+++ b/ggml/src/ggml-cuda/CMakeLists.txt
@@ -263,6 +263,16 @@ if (CUDAToolkit_FOUND)
     endif()
 
     target_compile_options(ggml-cuda PRIVATE "$<$<COMPILE_LANGUAGE:CUDA>:${CUDA_FLAGS}>")
+    # Keep the established CUDA flags for other operations. Compile SenseNova mHC
+    # separately to avoid the global approximate exp/log and flush-to-zero mode.
+    add_library(ggml-cuda-mhc OBJECT precise/mhc.cu)
+    set_target_properties(ggml-cuda-mhc PROPERTIES POSITION_INDEPENDENT_CODE ON CUDA_STANDARD 17)
+    target_include_directories(ggml-cuda-mhc PRIVATE "$<TARGET_PROPERTY:ggml-cuda,INCLUDE_DIRECTORIES>")
+    target_compile_definitions(ggml-cuda-mhc PRIVATE "$<TARGET_PROPERTY:ggml-cuda,COMPILE_DEFINITIONS>")
+    list(REMOVE_ITEM CUDA_FLAGS -use_fast_math)
+    target_compile_options(ggml-cuda-mhc PRIVATE ${CUDA_FLAGS} --ftz=false --prec-div=true --prec-sqrt=true)
+    target_sources(ggml-cuda PRIVATE $<TARGET_OBJECTS:ggml-cuda-mhc>)
+
 else()
     message(FATAL_ERROR "CUDA Toolkit not found")
 endif()
