 }
 
+
+// inkling-turing: grouped-expert multi-token MoE mat-vec (verification / small batches, 2..8 tokens).
+// One warp per (expert, row pair). The block owning the first (slot, token) pair that selected an expert gathers every other
+// pair that selected the same expert and applies the dequantized weights to all of their activation rows, so each expert row is
+// read and dequantized once per batch instead of once per token. Per (pair, row) the lane partition, loop order and reduction
+// are those of mul_mat_vec_q_moe, so results are bit-identical. Grouping is on the GPU (CUDA graph safe).
+template <ggml_type type, int c_rows_per_block, int MM, bool has_fusion>
+__launch_bounds__(128, 4)
+static __global__ void mul_mat_vec_q_moe_grp(
+        const void * vx_ptr, const void * vy_ptr, const int32_t * ids_ptr, const ggml_cuda_mm_fusion_args_device fusion,
+        float * dst_ptr,
+        const uint32_t ncols_x, const uint3 nchannels_y, const uint32_t nrows_x,
+        const uint32_t stride_row_x, const uint32_t stride_col_y, const uint32_t stride_col_dst,
+        const uint32_t stride_channel_x, const uint32_t stride_channel_y, const uint32_t stride_channel_dst,
+        const uint32_t ncols_dst, const uint32_t ids_stride, const uint32_t nchannels_dst) {
+    const void    * GGML_CUDA_RESTRICT vx  = vx_ptr;
+    const void    * GGML_CUDA_RESTRICT vy  = vy_ptr;
+    const int32_t * GGML_CUDA_RESTRICT ids = ids_ptr;
+    float         * GGML_CUDA_RESTRICT dst = dst_ptr;
+
+    constexpr int qk  = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi  = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr = get_vdr_mmvq(type);
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    constexpr vec_dot_q_cuda_t vec_dot_q_cuda = get_vec_dot_q_cuda(type);
+
+    bool use_gate = false;
+    const void  * vgate      = nullptr;
+    const float * x_bias     = nullptr;
+    const float * gate_bias  = nullptr;
+    const float * x_scale    = nullptr;
+    const float * gate_scale = nullptr;
+    ggml_glu_op   active_glu = GGML_GLU_OP_SWIGLU;
+    float         glu_limit  = 0.0f;
+    if constexpr (has_fusion) {
+        use_gate   = fusion.gate != nullptr;
+        vgate      = fusion.gate;
+        x_bias     = (const float *) fusion.x_bias;
+        gate_bias  = (const float *) fusion.gate_bias;
+        active_glu = fusion.glu_op;
+        glu_limit  = fusion.glu_limit;
+        if constexpr (type == GGML_TYPE_NVFP4) {
+            x_scale    = (const float *) fusion.x_scale;
+            gate_scale = (const float *) fusion.gate_scale;
+        }
+    }
+
+    const int row0 = c_rows_per_block*(blockIdx.x*4 + threadIdx.y);
+    const uint32_t p = blockIdx.y;
+
+    ggml_cuda_pdl_sync();
+    const uint32_t npairs = nchannels_dst * ncols_dst; // <= 64 (host guard)
+    const int32_t  e      = ids[(p % nchannels_dst) + (p / nchannels_dst) * ids_stride];
+    // lane l inspects pairs l and l+32 in parallel
+    const uint32_t q0 = threadIdx.x, q1 = threadIdx.x + 32;
+    const int32_t  e0 = q0 < npairs ? ids[(q0 % nchannels_dst) + (q0 / nchannels_dst) * ids_stride] : -1;
+    const int32_t  e1 = q1 < npairs ? ids[(q1 % nchannels_dst) + (q1 / nchannels_dst) * ids_stride] : -1;
+    const uint32_t m0 = __ballot_sync(0xffffffffu, e0 == e);
+    const uint32_t m1 = __ballot_sync(0xffffffffu, e1 == e);
+    uint64_t mask = ((uint64_t) m1 << 32) | m0;
+    if (mask & ((p >= 64 ? ~0ull : ((1ull << p) - 1)))) {
+        return; // an earlier pair owns this expert
+    }
+    if (row0 >= (int) nrows_x) {
+        return;
+    }
+    int cnt = 0;
+    uint32_t sl[MM], tk[MM];
+    while (mask != 0 && cnt < MM) {
+        const uint32_t q = __ffsll((long long) mask) - 1;
+        mask &= mask - 1;
+        sl[cnt] = q % nchannels_dst;
+        tk[cnt] = q / nchannels_dst;
+        ++cnt;
+    }
+    for (int j = cnt; j < MM; ++j) { // keep the loop body index-safe; never used
+        sl[j] = sl[0];
+        tk[j] = tk[0];
+    }
+
+    const int blocks_per_row_x = ncols_x / qk;
+    constexpr int blocks_per_iter = vdr * warp_size / qi;
+    const uint32_t channel_x = e;
+    const int kbx_offset = channel_x*stride_channel_x + row0*stride_row_x;
+
+    const block_q8_1 * y[MM];
+#pragma unroll
+    for (int j = 0; j < MM; ++j) {
+        y[j] = ((const block_q8_1 *) vy) + fastmodulo(sl[j], nchannels_y)*stride_channel_y + tk[j]*stride_col_y;
+    }
+
+    float tmp[MM][c_rows_per_block] = {};
+    float tmp_gate[MM][c_rows_per_block] = {};
+
+    for (int kbx = threadIdx.x / (qi/vdr); kbx < blocks_per_row_x; kbx += blocks_per_iter) {
+        const int kby = kbx * (qk/QK8_1);
+        const int kqs = vdr * (threadIdx.x % (qi/vdr));
+#pragma unroll
+        for (int i = 0; i < c_rows_per_block; ++i) {
+#pragma unroll
+            for (int j = 0; j < MM; ++j) {
+                if (j < cnt) {
+                    tmp[j][i] += vec_dot_q_cuda(vx, &y[j][kby], kbx_offset + i*stride_row_x + kbx, kqs);
+                    if constexpr (has_fusion) {
+                        if (use_gate) {
+                            tmp_gate[j][i] += vec_dot_q_cuda(vgate, &y[j][kby], kbx_offset + i*stride_row_x + kbx, kqs);
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    ggml_cuda_pdl_lc();
+
+#pragma unroll
+    for (int j = 0; j < MM; ++j) {
+#pragma unroll
+        for (int i = 0; i < c_rows_per_block; ++i) {
+            tmp[j][i] = warp_reduce_sum<warp_size>(tmp[j][i]);
+            if constexpr (has_fusion) {
+                if (use_gate) {
+                    tmp_gate[j][i] = warp_reduce_sum<warp_size>(tmp_gate[j][i]);
+                }
+            }
+        }
+    }
+
+#pragma unroll
+    for (int j = 0; j < MM; ++j) {
+        if (j < cnt && threadIdx.x < c_rows_per_block && (c_rows_per_block == 1 || uint32_t(row0 + threadIdx.x) < nrows_x)) {
+            float result = tmp[j][threadIdx.x];
+            if constexpr (has_fusion) {
+                const uint32_t bias_idx = channel_x*stride_channel_dst + row0 + threadIdx.x;
+                if constexpr (type == GGML_TYPE_NVFP4) {
+                    if (x_scale) {
+                        result *= x_scale[channel_x];
+                    }
+                }
+                if (x_bias) {
+                    result += x_bias[bias_idx];
+                }
+                if (use_gate) {
+                    float gate_value = tmp_gate[j][threadIdx.x];
+                    if constexpr (type == GGML_TYPE_NVFP4) {
+                        if (gate_scale) {
+                            gate_value *= gate_scale[channel_x];
+                        }
+                    }
+                    if (gate_bias) {
+                        gate_value += gate_bias[bias_idx];
+                    }
+                    switch (active_glu) {
+                        case GGML_GLU_OP_SWIGLU:
+                            result *= ggml_cuda_op_silu_single(gate_value);
+                            break;
+                        case GGML_GLU_OP_GEGLU:
+                            result *= ggml_cuda_op_gelu_single(gate_value);
+                            break;
+                        case GGML_GLU_OP_SWIGLU_OAI:
+                            result = ggml_cuda_op_swiglu_oai_single(gate_value, result);
+                            break;
+                        case GGML_GLU_OP_SWIGLU_CLAMP:
+                            result = ggml_cuda_op_swiglu_clamp_single(gate_value, result, glu_limit);
+                            break;
+                        default:
+                            result = result * gate_value;
+                            break;
+                    }
+                }
+            }
+            dst[sl[j]*stride_channel_dst + tk[j]*stride_col_dst + row0 + threadIdx.x] = result;
+        }
+    }
+
+    if constexpr (!has_fusion) {
+        GGML_UNUSED_VARS(use_gate, tmp_gate, vgate, x_bias, gate_bias, active_glu, glu_limit, x_scale, gate_scale);
+    } else if constexpr (type != GGML_TYPE_NVFP4) {
+        GGML_UNUSED_VARS(x_scale, gate_scale);
+    }
+}
+
 template<ggml_type type>
 static std::pair<dim3, dim3> calc_launch_params(
         const int ncols_dst, const int nrows_x, const int nchannels_dst, const int nsamples_or_ntokens,
@@ -1161,6 +1343,32 @@ static void mul_mat_vec_q_moe_launch(
 
     constexpr int rows_per_block = 2; // 2 gives best perf based on tuning
     const int64_t nblocks_rows = (nrows_x + rows_per_block - 1) / rows_per_block;
+
+    // inkling-turing: grouped-expert kernel for 2..8 tokens (bit-exact; GGML_CUDA_INK_T_GRP=0 disables)
+    static const int ink_grp = [] { const char * v = getenv("GGML_CUDA_INK_T_GRP"); return v ? atoi(v) : 0; }();
+    if (ink_grp && ncols_dst >= 2 && ncols_dst <= 8 && nchannels_dst * ncols_dst <= 64 && fusion.shared_up == nullptr) {
+        const bool has_fusion_g = fusion.gate != nullptr || fusion.x_bias != nullptr || fusion.gate_bias != nullptr ||
+                                  fusion.x_scale != nullptr || fusion.gate_scale != nullptr;
+        const dim3 gnums((nblocks_rows + 3) / 4, nchannels_dst * ncols_dst);
+        const dim3 gdims(warp_size, 4);
+        const ggml_cuda_kernel_launch_params glp = ggml_cuda_kernel_launch_params(gnums, gdims, 0, stream);
+        auto go = [&](auto mm_tag, auto fus_tag) {
+            constexpr int MMc = decltype(mm_tag)::value;
+            constexpr bool F = decltype(fus_tag)::value;
+            ggml_cuda_kernel_launch(mul_mat_vec_q_moe_grp<type, rows_per_block, MMc, F>, glp,
+                vx, vy, ids, fusion, dst, ncols_x, nchannels_y, nrows_x,
+                stride_row_x, stride_col_y, stride_col_dst,
+                stride_channel_x, stride_channel_y, stride_channel_dst,
+                ncols_dst, ids_stride, (uint32_t) nchannels_dst);
+        };
+        auto pick = [&](auto fus_tag) {
+            if (ncols_dst <= 2)      { go(std::integral_constant<int, 2>(), fus_tag); }
+            else if (ncols_dst <= 4) { go(std::integral_constant<int, 4>(), fus_tag); }
+            else                     { go(std::integral_constant<int, 8>(), fus_tag); }
+        };
+        if (has_fusion_g) { pick(std::true_type()); } else { pick(std::false_type()); }
+        return;
+    }
     const dim3 block_nums(nblocks_rows, nchannels_dst + (fusion.shared_up != nullptr));
     const dim3 block_dims(warp_size, ncols_dst);
     const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(block_nums, block_dims, 0, stream);
