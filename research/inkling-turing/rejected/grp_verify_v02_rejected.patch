index 18a2e51..b0b8141 100644
--- a/ggml/src/ggml-cuda/mmvq.cu
+++ b/ggml/src/ggml-cuda/mmvq.cu
@@ -1104,6 +1104,188 @@ static __global__ void mul_mat_vec_q_moe(
