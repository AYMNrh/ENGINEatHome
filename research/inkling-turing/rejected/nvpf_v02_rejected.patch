+// inkling-turing: NVFP4 loader split in two so the global loads of the next K tile can be issued before the MMAs of the
+// current one (Turing has no cp.async; the serial LDG->STS chain was 69% long_scoreboard). Pure data movement: bit-exact.
+struct ink_nvfp4_raw { uint32_t q[2][8]; uint32_t d[2]; };
+
+template <ggml_type type, int J, bool fallback, ggml_prec prec_src1, bool has_fusion> static __device__ __forceinline__ void ink_nvfp4_fetch(
+        ink_nvfp4_raw & rw, const char * __restrict__ x, const char * __restrict__ x_gate, const int kb0, const int i_max, const int stride) {
+    constexpr int warp_size   = ggml_cuda_get_physical_warp_size();
+    constexpr int nwarps      = ggml_cuda_mmq_get_nthreads(type, J, fallback, prec_src1) / warp_size;
+    constexpr int I           = ggml_cuda_mmq_get_I(type, J, fallback, prec_src1);
+    constexpr int threads_per_row = MMQ_ITER_K / QK_NVFP4;
+    constexpr int rows_per_warp = warp_size / threads_per_row;
+    const int kbx = threadIdx.x % threads_per_row;
+    const int row_in_warp = threadIdx.x / threads_per_row;
+#pragma unroll
+    for (int p = 0; p < I / (rows_per_warp * nwarps); ++p) {
+        int i = p * rows_per_warp * nwarps + threadIdx.y * rows_per_warp + row_in_warp;
+        if constexpr (fallback) {
+            i = min(i, i_max);
+        }
+        const block_nvfp4 * bxi = ggml_cuda_mmq_x_row<block_nvfp4, has_fusion>(x, x_gate, kb0, i, stride) + kbx;
+        const uint32_t * __restrict__ src_qs = reinterpret_cast<const uint32_t *>(bxi->qs);
+        rw.d[p] = *reinterpret_cast<const uint32_t *>(bxi->d);
+#pragma unroll
+        for (int k = 0; k < 8; ++k) {
+            rw.q[p][k] = src_qs[k];
+        }
+    }
+}
