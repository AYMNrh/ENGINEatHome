 }
 
 
+
+// inkling-turing: IQ3_XXS "fragment-direct" dot. The x tile never goes through shared memory: every lane builds its IMMA A
+// fragments (4 int8 values = one grid entry with its signs) straight from the global block, using the shared-memory grid.
+// Same int8 values, same scales and same accumulation order as load_tiles_iq3_xxs + vec_dot_q8_0_q8_1_mma, so bit-exact.
+template <ggml_type type, int J, bool fallback> static __device__ __forceinline__ void ink_vec_dot_iq3_direct(
+        const block_iq3_xxs * __restrict__ xb, const int stride_blocks, const int i_max,
+        const int * __restrict__ y, float * __restrict__ sum, const int g0) {
+#if defined(TURING_MMA_AVAILABLE) && !defined(AMD_MFMA_AVAILABLE) && !defined(AMD_WMMA_AVAILABLE)
+    typedef tile<16, 8, int> tile_A;
+    typedef tile< 8, 8, int> tile_B;
+    typedef tile<16, 8, int> tile_C;
+
+    constexpr int rows_per_warp = ggml_cuda_mmq_get_rows_per_warp(type, J, fallback, GGML_PREC_Q8);
+    constexpr int ntx           = rows_per_warp/tile_C::I;
+
+    y += (threadIdx.y % ntx) * (tile_C::J*MMQ_TILE_Y_K);
+    const int   * y_qs = (const int   *) y + 4;
+    const float * y_df = (const float *) y;
+
+    const uint32_t * grid_tab = ink_t_grid_smem<GGML_TYPE_IQ3_XXS>();
+
+    tile_A A[ntx][MMQ_TILE_NE_K/QI8_0];
+    float dA[ntx][tile_C::ne/2][MMQ_TILE_NE_K/QI8_0];
+
+    const int i0 = (threadIdx.y/ntx)*rows_per_warp;
+
+#pragma unroll
+    for (int n = 0; n < ntx; ++n) {
+#pragma unroll
+        for (int g = 0; g < MMQ_TILE_NE_K/QI8_0; ++g) {
+            const int gg = g0 + g; // 32-value group inside the 256-value super-block
+#pragma unroll
+            for (int l = 0; l < tile_A::ne; ++l) {
+                int row = i0 + n*tile_A::I + tile_A::get_i(l);
+                if (fallback) {
+                    row = min(row, i_max);
+                }
+                const block_iq3_xxs * bxi = xb + (int64_t) row*stride_blocks;
+                const int s = tile_A::get_j(l); // int slot (0..7) of the group = index byte s
+                const uint32_t aux32 = get_int_b2(bxi->qs, QK_K/16 + gg);
+                const uint32_t w     = get_int_b2(bxi->qs, 2*gg + (s >> 2));
+                const uint32_t idx   = (w >> (8*(s & 3))) & 0xFF;
+                const uint32_t v8    = (aux32 >> (7*(s >> 1))) & 0xFF;
+                const uint32_t sgn   = v8 ^ ((__popc(v8) & 1) << 7);
+                const uint32_t sg4   = (s & 1) ? (sgn >> 4) : (sgn & 0x0F);
+                A[n][g].x[l] = ink_t_apply_signs4(grid_tab[idx], sg4);
+            }
+        }
+
+#pragma unroll
+        for (int l = 0; l < tile_C::ne/2; ++l) {
+            int row = i0 + n*tile_A::I + tile_C::get_i(2*l);
+            if (fallback) {
+                row = min(row, i_max);
+            }
+            const block_iq3_xxs * bxi = xb + (int64_t) row*stride_blocks;
+#pragma unroll
+            for (int g = 0; g < MMQ_TILE_NE_K/QI8_0; ++g) {
+                const int gg = g0 + g;
+                const uint32_t aux32 = get_int_b2(bxi->qs, QK_K/16 + gg);
+                const int ls = aux32 >> 28;
+                const float d = bxi->d;
+                dA[n][l][g] = (ls*d + d/2)/2;
+            }
+        }
+    }
+
+#pragma unroll
+    for (int j0 = 0; j0 < J; j0 += ntx*tile_C::J) {
+#pragma unroll
+        for (int k01 = 0; k01 < MMQ_TILE_NE_K; k01 += QI8_0) {
+            tile_B B;
+            float dB[tile_C::ne/2];
+
+            load_generic(B, y_qs + j0*MMQ_TILE_Y_K + k01, MMQ_TILE_Y_K);
+
+#pragma unroll
+            for (int l = 0; l < tile_C::ne/2; ++l) {
+                const int j = j0 + tile_C::get_j(l);
+                dB[l] = y_df[j*MMQ_TILE_Y_K + k01/QI8_1];
+            }
+
+#pragma unroll
+            for (int n = 0; n < ntx; ++n) {
+                tile_C C;
+                mma(C, A[n][k01/QI8_0], B);
+
+#pragma unroll
+                for (int l = 0; l < tile_C::ne; ++l) {
+                    sum[(j0/tile_C::J + n)*tile_C::ne + l] += ink_t_i2f(C.x[l])*dA[n][l/2][k01/QI8_0]*dB[l%2];
+                }
+            }
+        }
+    }
+#else
+    GGML_UNUSED_VARS(xb, stride_blocks, i_max, y, sum, g0);
+    NO_DEVICE_CODE;
+#endif // TURING_MMA_AVAILABLE
+}
