-                }
-                INK_T_FAIL();
+    const ggml_tensor * outs[] = { q_rot, k_rot, v_rot, set_k, set_v };
+    const ggml_tensor * stage_in[4] = { cq.src[0], ck.src[0], v_norm->src[0], tau };
+    const ggml_tensor * own_out[4]  = { q_rot, k_rot, v_rot, nullptr };
+    int stage = 0;
+    for (int b = 0; b < 4; ++b) {
