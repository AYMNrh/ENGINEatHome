diff --git a/ggml/src/ggml-cuda/mmq-load-tiles.cuh b/ggml/src/ggml-cuda/mmq-load-tiles.cuh
index 31943ee..2161eac 100644
--- a/ggml/src/ggml-cuda/mmq-load-tiles.cuh
+++ b/ggml/src/ggml-cuda/mmq-load-tiles.cuh
@@ -1771,14 +1771,14 @@ template <ggml_type type, int J, bool fallback, ggml_prec prec_src1, bool has_fu
 #if defined(AMD_MFMA_AVAILABLE) || defined(TURING_MMA_AVAILABLE) || defined(AMD_WMMA_AVAILABLE)
     constexpr int sram_stride = ggml_cuda_mmq_get_sram_stride(type, J, fallback, prec_src1);
     int   * x_qs = (int   *) x_tile;
-    float * x_df = (float *) (x_qs + MMQ_TILE_NE_K*2);
+    float * x_df = (float *) (x_qs + ggml_cuda_mmq_df_offset(ggml_cuda_mmq_get_sram_layout(type, J, fallback, prec_src1)));
 #else
     constexpr tile_x_sizes txs = mmq_get_dp4a_tile_x_sizes(GGML_TYPE_NVFP4, I);
     int   * x_qs = (int   *) x_tile;
     float * x_df = (float *) (x_qs + txs.qs);
 #endif // defined(AMD_MFMA_AVAILABLE) || defined(TURING_MMA_AVAILABLE) || defined(AMD_WMMA_AVAILABLE)
 
-    constexpr int threads_per_row = MMQ_ITER_K / QK_NVFP4;
+    constexpr int threads_per_row = ggml_cuda_mmq_get_K_vram(type, J, fallback, prec_src1) / QK_NVFP4;
     constexpr int rows_per_warp = warp_size / threads_per_row;
     const int kbx = threadIdx.x % threads_per_row;
     const int row_in_warp = threadIdx.x / threads_per_row;
diff --git a/ggml/src/ggml-cuda/mmq-vec-dot.cuh b/ggml/src/ggml-cuda/mmq-vec-dot.cuh
index dc35a08..8629cb4 100644
