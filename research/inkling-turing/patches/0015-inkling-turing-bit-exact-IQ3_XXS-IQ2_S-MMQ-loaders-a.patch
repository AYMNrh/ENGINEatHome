@@ -254,9 +254,22 @@ void ggml_cuda_mul_mat_q(
 
             // Each expert only sees ne12*n_expert_used/ne02 tokens on average.
             ncols_opt = (ne12*n_expert_used + ne02 - 1) / ne02;
+            // inkling-turing: routing is uneven, so size the tile for 1.5x the average expert load; a second
+            // mostly-empty column tile re-dequantizes the whole expert slice, which costs more than idle MMA columns.
+            // (measured on the 2080 Ti at -ub 512: J=48 vs J=32 +2..3% prefill, bit-exact)
+            ncols_opt = (3*ncols_opt + 1) / 2;
         }
 
         J_best = ggml_cuda_mmq_get_J_best(src0->type, ncols_opt, fallback, cc, smpbo, prec_src1, &nthreads_best);
+        // inkling-turing: experimental override of the MoE tile width (GGML_CUDA_INK_T_MMQJ=<J>), default off
+        static const int ink_t_mmqj = getenv("GGML_CUDA_INK_T_MMQJ") ? atoi(getenv("GGML_CUDA_INK_T_MMQJ")) : 0;
+        if (ids && ink_t_mmqj > 0) {
+            const ggml_cuda_mmq_config cfg = ggml_cuda_mmq_get_config(src0->type, ink_t_mmqj, fallback, cc, prec_src1);
+            if (cfg.type != GGML_TYPE_COUNT && mmq_get_nbytes_shared(cfg, cc) + ggml_cuda_ink_t_lut_bytes(src0->type) <= smpbo) {
+                J_best = ink_t_mmqj;
+                nthreads_best = cfg.nthreads;
+            }
+        }
     }
     GGML_ASSERT(J_best > 0);
 
