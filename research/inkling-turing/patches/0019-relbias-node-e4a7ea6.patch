 #include <algorithm>
 #include <array>
@@ -2818,6 +2819,12 @@ static void ggml_cuda_mul_mat_id(ggml_backend_cuda_context & ctx, ggml_tensor *
 
 static bool ggml_cuda_compute_forward(ggml_backend_cuda_context & ctx, struct ggml_tensor * dst) {
     switch (dst->op) {
+        case GGML_OP_CUSTOM:
+            if (!ggml_is_inkling2_relbias(dst) || !ggml_cuda_inkling2_relbias_node_supported(dst)) {
+                return false;
+            }
+            ggml_cuda_inkling2_relbias_node(ctx, dst);
+            break;
         case GGML_OP_ARGMAX:
             ggml_cuda_argmax(ctx, dst);
             break;
@@ -6802,6 +6809,8 @@ static bool ggml_backend_cuda_device_supports_op(ggml_backend_dev_t dev, const g
             }
         case GGML_OP_DUP:
                 return true;
+        case GGML_OP_CUSTOM:
+            return ggml_is_inkling2_relbias(op) && ggml_cuda_inkling2_relbias_node_supported(op);
         case GGML_OP_ARGMAX:
         case GGML_OP_COUNT_EQUAL:
             return true;
diff --git a/ggml/src/ggml-cuda/inkling2.cu b/ggml/src/ggml-cuda/inkling2.cu
index c317227..f516507 100644
--- a/ggml/src/ggml-cuda/inkling2.cu
+++ b/ggml/src/ggml-cuda/inkling2.cu
@@ -6,6 +6,7 @@
 #include "../ggml-impl.h"
 
 #include <algorithm>
+#include "ggml-inkling2.h"
 
 // Every fusion except one MIX path gives the same bits as the op chain it replaces: the kernels keep the order of
 // every fp32 operation, round each intermediate the unfused kernels store (__fmul_rn/__fsub_rn/__fadd_rn, so nothing
@@ -2615,6 +2616,21 @@ static __global__ void inkling2t_relbias_f32(const float * W, const int nW, cons
     }
 }
 
+// the mask as one graph node (ggml_inkling2_relbias): the same inputs and output as the matched chain, one node
+static bool inkling2_match_relbias_node(const ggml_cgraph * cgraph, int i, ggml_cuda_inkling2_args & args) {
+    const ggml_tensor * n = cgraph->nodes[i];
+    if (!ggml_is_inkling2_relbias(n) || !ggml_cuda_inkling2_relbias_node_supported(n)) {
+        return false;
+    }
+    args.type    = GGML_CUDA_INKLING2_RELBIAS;
+    args.n_nodes = 1;
+    args.dst     = const_cast<ggml_tensor *>(n);
+    for (int j = 0; j < 4; ++j) {
+        args.src[j] = n->src[j];
+    }
+    return true;
+}
+
 static bool inkling2t_match_relbias_t(const ggml_cgraph * cgraph, int i, ggml_cuda_inkling2_args & args) {
     if (!inkling2t_enabled(2)) {
         return false;
@@ -2637,7 +2653,7 @@ static bool inkling2t_match_relbias_t(const ggml_cgraph * cgraph, int i, ggml_cu
     }
     k = inkling2t_skip_views(cgraph, k + 1);
     ggml_cuda_inkling2_args rb;
-    if (k >= cgraph->n_nodes || !inkling2_match_relbias(cgraph, k, rb) || rb.src[0] != mm) INK_T_FAIL();
+    if (k >= cgraph->n_nodes || !(inkling2_match_relbias(cgraph, k, rb) || inkling2_match_relbias_node(cgraph, k, rb)) || rb.src[0] != mm) INK_T_FAIL();
     int end = k + rb.n_nodes - 1;
 
     const ggml_tensor * fill = nullptr;
@@ -3076,3 +3092,38 @@ void ggml_cuda_inkling2_fused(ggml_backend_cuda_context & ctx, const ggml_cuda_i
         default: GGML_ABORT("fatal error");
     }
 }
+
+// ---- the mask as one graph node (ggml_inkling2_relbias) --------------------------------------------------------------------
+bool ggml_cuda_inkling2_relbias_node_supported(const ggml_tensor * dst) {
+    const ggml_tensor * tab  = dst->src[0];
+    const ggml_tensor * s    = dst->src[1];
+    const ggml_tensor * pos  = dst->src[2];
+    const ggml_tensor * mask = dst->src[3];
+    if (!tab || !s || !pos || !mask) {
+        return false;
+    }
+    const int64_t n_rows = tab->ne[0];
+    const int64_t n_head = tab->ne[1];
+    const int64_t n_tok  = tab->ne[2];
+    const int64_t n_kv   = pos->ne[0];
+    return inkling2_is_f32_rows(tab) && tab->ne[3] == 1 &&
+        s->type == GGML_TYPE_F32 && ggml_is_contiguous(s) && s->ne[0] == 1 && s->ne[1] == n_head && s->ne[2] == n_tok && s->ne[3] == 1 &&
+        pos->type == GGML_TYPE_I32 && pos->nb[0] == sizeof(int32_t) && pos->ne[1] == n_tok && pos->ne[2] == 1 &&
+        (mask->type == GGML_TYPE_F16 || mask->type == GGML_TYPE_F32) && mask->nb[0] == ggml_type_size(mask->type) &&
+        mask->ne[0] == n_kv && mask->ne[1] == n_tok && mask->ne[2] == 1 && mask->ne[3] == 1 &&
+        (dst->type == GGML_TYPE_F16 || dst->type == GGML_TYPE_F32) && ggml_is_contiguous(dst) &&
+        dst->ne[0] == n_kv && dst->ne[1] == n_tok && dst->ne[2] == n_head && dst->ne[3] == 1 &&
+        n_kv <= INT_MAX && n_rows <= INT_MAX && n_tok <= 65535 && n_head <= 65535;
+}
+
+void ggml_cuda_inkling2_relbias_node(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    ggml_cuda_inkling2_args args;
+    args.type    = GGML_CUDA_INKLING2_RELBIAS;
+    args.n_nodes = 1;
+    args.dst     = dst;
+    args.src[0]  = dst->src[0];
+    args.src[1]  = dst->src[1];
+    args.src[2]  = dst->src[2];
+    args.src[3]  = dst->src[3];
+    inkling2_relbias(ctx, args);
+}
