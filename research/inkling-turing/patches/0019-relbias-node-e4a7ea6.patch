 #include "llama-impl.h"
 #include "llama-model.h"
@@ -4511,6 +4512,36 @@ ggml_tensor * llm_graph_context::build_attn(
     return build_attn_iswa_impl(*this, inp_attn, wo, wo_b, wo_s, q_cur, k_cur, v_cur, nullptr, kq_mask, nullptr, sinks, nullptr, kq_scale, il);
 }
 
+ggml_tensor * llm_graph_context::build_attn_relbias(
+        llm_graph_input_mem_hybrid_iswa_rel * inp,
+        ggml_tensor * wo,
+        ggml_tensor * wo_b,
+        ggml_tensor * wo_s,
+        ggml_tensor * q_cur,
+        ggml_tensor * k_cur,
+        ggml_tensor * v_cur,
+        ggml_tensor * rel_tab,
+        ggml_tensor * rel_s,
+        ggml_tensor * rel_pos,
+        ggml_tensor * sinks,
+            float     kq_scale,
+            int       il) const {
+    const bool is_swa = hparams.is_swa(il);
+
+    auto * inp_attn = inp->get_attn();
+
+    const auto & attn_mask = is_swa ? inp_attn->self_attn_mask_swa : inp_attn->self_attn_mask;
+
+    GGML_ASSERT(attn_mask.rows == nullptr);
+    GGML_ASSERT(attn_mask.raw->ne[3] == 1);
+
+    ggml_tensor * kq_mask = ggml_inkling2_relbias(ctx0, rel_tab, rel_s, rel_pos, attn_mask.raw,
+            cparams.flash_attn ? GGML_TYPE_F16 : GGML_TYPE_F32);
+    cb(kq_mask, "kq_mask_rel_pos", il);
+
+    return build_attn_iswa_impl(*this, inp_attn, wo, wo_b, wo_s, q_cur, k_cur, v_cur, nullptr, kq_mask, nullptr, sinks, nullptr, kq_scale, il);
+}
+
 void llm_graph_context::build_dense_out(
     ggml_tensor * dense_2,
     ggml_tensor * dense_2_b,
diff --git a/src/llama-graph.h b/src/llama-graph.h
index a9f8e5c..864ebcd 100644
--- a/src/llama-graph.h
+++ b/src/llama-graph.h
@@ -1554,6 +1554,23 @@ struct llm_graph_context {
                   float   kq_scale,
                     int   il) const;
 
+    // the same as build_attn above, with the per-head mask built by ONE node (ggml_inkling2_relbias) from the bias table
+    // instead of the kq_b chain: no F32 [n_head, n_kv, n_tokens] intermediates for the allocator to plan. n_stream must be 1.
+    ggml_tensor * build_attn_relbias(
+            llm_graph_input_mem_hybrid_iswa_rel * inp,
+            ggml_tensor * wo,
+            ggml_tensor * wo_b,
+            ggml_tensor * wo_s,
+            ggml_tensor * q_cur,   // [n_embd_head_q, n_head_q, n_tokens]
+            ggml_tensor * k_cur,   // [n_embd_head_k, n_head_k, n_tokens]
+            ggml_tensor * v_cur,   // [n_embd_head_v, n_head_v, n_tokens]
+            ggml_tensor * rel_tab, // [n_rows, n_head_q, n_tokens]: r projected on the bias table
+            ggml_tensor * rel_s,   // [1, n_head_q, n_tokens]: the sink logit of each query, subtracted from the table
+            ggml_tensor * rel_pos, // [n_kv, n_tokens]: the distances
+            ggml_tensor * sinks,   // [n_head_q]
+                  float   kq_scale,
+                    int   il) const;
+
     //
     // pooling
     //
diff --git a/src/models/inkling2.cpp b/src/models/inkling2.cpp
index 02bfbf1..12b692f 100644
--- a/src/models/inkling2.cpp
+++ b/src/models/inkling2.cpp
@@ -419,6 +419,20 @@ ggml_tensor * llama_model_inkling2::graph::build_layer(int il, int ip, ggml_tens
         // project r on the bias table first, then gather by distance: only the gathered bias is n_kv x n_tokens x n_head
         ggml_tensor * table = ggml_mul_mat(ctx0, ggml_pad(ctx0, layer.attn_rel_bias, 0, 1, 0, 0), Rcur);
 
+        // the mask of each head is one node (ggml_inkling2_relbias), so that no F32 [n_head, n_kv, n_tokens] intermediates are
+        // planned by the allocator (at 256K they are most of the compute buffer). All batch sizes: the prefill and the decode graph
+        // keep the same topology (a different one makes the scheduler re-plan the buffer at every switch); the decode fusion
+        // RELBIAS_T takes the node as it took the chain. LLAMA_INK_RELBIAS_NODE=0 keeps the chain.
+        static const bool relbias_node = [] { const char * e = getenv("LLAMA_INK_RELBIAS_NODE"); return !e || atoi(e) != 0; }();
+        if (relbias_node && n_stream == 1) {
+            ggml_tensor * rel_sinks = sinks;
+
+            sinks = ggml_fill(ctx0, ggml_new_tensor_1d(ctx0, GGML_TYPE_F32, n_head), 0.0f);
+
+            cur = build_attn_relbias(inp,
+                    nullptr, nullptr, nullptr,
+                    Qcur, Kcur, Vcur, table, rel_sinks, rel_pos, sinks, 1.0f/sqrtf(n_embd_head), il);
+        } else {
         // the sink logit t is per query: exp(s - t)/(1 + sum(exp(s - t))) = exp(s)/(exp(t) + sum(exp(s))), with a zero sink
         table = ggml_sub(ctx0, table, sinks);
         table = ggml_cont(ctx0, ggml_permute(ctx0, table, 1, 0, 2, 3));
@@ -433,6 +447,7 @@ ggml_tensor * llama_model_inkling2::graph::build_layer(int il, int ip, ggml_tens
         cur = build_attn(inp,
                 nullptr, nullptr, nullptr,
                 Qcur, Kcur, Vcur, kq_b, sinks, 1.0f/sqrtf(n_embd_head), il);
+        }
 
         cur = ggml_mul(ctx0, cur, ggml_sigmoid(ctx0, gate_proj));
         cur = convolve(build_lora_mm(layer.wo, cur), layer.attn_post_conv, nullptr, state, history, recr, 2*n_embd_k_gqa);
