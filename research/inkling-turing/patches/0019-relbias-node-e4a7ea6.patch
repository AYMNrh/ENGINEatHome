From e4a7ea6757f39032fbfb0c6dd62c31155a412c92 Mon Sep 17 00:00:00 2001
From: inkling-turing <inkling-turing@local>
Date: Sun, 22 Nov 2026 16:21:41 +0100
Subject: [PATCH] inkling-turing: relative-bias mask as one graph node
 (ggml_inkling2_relbias): no F32 [n_head, n_kv, n_tokens] intermediates in the
 compute buffer, bit-exact

The mask of each head was a chain of nodes that the CUDA backend fused only at execution, so ggml-alloc still planned the F32 intermediates
(199 bytes per ub x n_kv). One GGML_OP_CUSTOM node (CPU reference + the existing CUDA kernel) plans only the F16 mask (about 55 bytes).
All batch sizes use it so that the prefill and decode graphs have the same topology (mixed topologies made the scheduler re-plan the buffer at every
prefill/decode switch, which exposed a stale CUDA graph pointer crash); the decode fusion RELBIAS_T matches the node. LLAMA_INK_RELBIAS_NODE=0 keeps the chain.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 ggml/include/ggml-inkling2.h    | 27 +++++++++++++
 ggml/src/ggml-cuda/ggml-cuda.cu |  9 +++++
 ggml/src/ggml-cuda/inkling2.cu  | 53 +++++++++++++++++++++++-
 ggml/src/ggml-cuda/inkling2.cuh |  4 ++
 ggml/src/ggml.c                 | 71 +++++++++++++++++++++++++++++++++
 src/llama-graph.cpp             | 31 ++++++++++++++
 src/llama-graph.h               | 17 ++++++++
 src/models/inkling2.cpp         | 15 +++++++
 tests/test-backend-ops.cpp      | 37 +++++++++++++++--
 9 files changed, 259 insertions(+), 5 deletions(-)
 create mode 100644 ggml/include/ggml-inkling2.h

diff --git a/ggml/include/ggml-inkling2.h b/ggml/include/ggml-inkling2.h
new file mode 100644
index 0000000..cc544e3
--- /dev/null
+++ b/ggml/include/ggml-inkling2.h
@@ -0,0 +1,27 @@
+#pragma once
+
+#include "ggml.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+    // Inkling 2: the attention mask with the relative-position bias of every head, as ONE node:
+    //   dst[kv, t, h] = type((tab[clamp(pos[kv, t], 0, n_rows - 1), h, t] - sinks[0, h, t]) + mask[kv, t])
+    // tab F32 [n_rows, n_head, n_tokens] (rows contiguous), sinks F32 [1, n_head, n_tokens], pos I32 [n_kv, n_tokens],
+    // mask F16/F32 [n_kv, n_tokens], dst F16/F32 [n_kv, n_tokens, n_head]. Same arithmetic as the chain SUB, GET_ROWS, ADD, CPY
+    // that it replaces, but the F32 [n_head, n_kv, n_tokens] intermediates of that chain never exist in the graph, so
+    // ggml-alloc does not plan memory for them. Built on GGML_OP_CUSTOM; the CUDA backend runs it with its own kernel.
+    GGML_API struct ggml_tensor * ggml_inkling2_relbias(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * tab,
+            struct ggml_tensor  * sinks,
+            struct ggml_tensor  * pos,
+            struct ggml_tensor  * mask,
+            enum ggml_type        type);
+
+    GGML_API bool ggml_is_inkling2_relbias(const struct ggml_tensor * t);
+
+#ifdef __cplusplus
+}
+#endif
