     const ggml_tensor * node[6] = {}; // further tensors of the chain: op parameters, views, intermediates
     const ggml_tensor * ext[20] = {}; // the tensors of the larger turing-iq3-opt fusions
+    const ggml_tensor * ext2[16] = {};
+    int n_ext = 0;
 };
 
