     GGML_CUDA_INKLING2_RELBIAS_T,  // PAD MUL_MAT + RELBIAS chain + FILL                (decode, turing-iq3-opt)
+    GGML_CUDA_INKLING2_CTRL_T,     // up to 3 loop controllers (CTRL_DOWN + CTRL_OUT each), decode (turing-iq3-opt)
     GGML_CUDA_INKLING2_ROUTE_TAIL, // SUM_ROWS SCALE DIV SCALE after the top-k           (decode, turing-iq3-opt)
