 ggml/src/ggml-cuda/ggml-cuda.cu |  7 ++-
 ggml/src/ggml-cuda/inkling2.cu  | 88 +++++++++++++++++++++++++++++----
 ggml/src/ggml-cuda/inkling2.cuh |  2 +
 ggml/src/ggml.c                 | 75 ++++++++++++++++++++++++++++
 src/llama-graph.cpp             | 72 +++++++++++++++++++++------
 src/llama-graph.h               | 13 ++++-
 src/llama-kv-cache.cpp          | 25 ++++++++++
 src/llama-kv-cache.h            |  6 +++
 src/models/inkling2.cpp         | 10 ++--
 tests/test-backend-ops.cpp      | 59 ++++++++++++++++++++--
 11 files changed, 339 insertions(+), 34 deletions(-)

diff --git a/ggml/include/ggml-inkling2.h b/ggml/include/ggml-inkling2.h
index cc544e3..fe212b5 100644
--- a/ggml/include/ggml-inkling2.h
+++ b/ggml/include/ggml-inkling2.h
@@ -22,6 +22,22 @@ extern "C" {
 
     GGML_API bool ggml_is_inkling2_relbias(const struct ggml_tensor * t);
 
+    // The same mask from POSITIONS instead of a dense I32 [n_kv, n_tokens] distance matrix:
+    //   d = cell[kv] >= 0 && tok[t] - cell[kv] >= 0 && tok[t] - cell[kv] < n_rows - 1 ? tok[t] - cell[kv] : n_rows - 1
+    //   dst[kv, t, h] = type((tab[d, h, t] - sinks[0, h, t]) + mask[kv, t])
+    // cell I32 [n_kv]: the position stored in each cell (-1 when empty), tok I32 [n_tokens]: the position of each token.
+    // Bit for bit the same values as the dense matrix version, without building or uploading the n_kv x n_tokens matrix.
+    GGML_API struct ggml_tensor * ggml_inkling2_relbias_pos(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * tab,
+            struct ggml_tensor  * sinks,
+            struct ggml_tensor  * cell,
+            struct ggml_tensor  * tok,
+            struct ggml_tensor  * mask,
+            enum ggml_type        type);
+
+    GGML_API bool ggml_is_inkling2_relbias_pos(const struct ggml_tensor * t);
+
 #ifdef __cplusplus
 }
 #endif
