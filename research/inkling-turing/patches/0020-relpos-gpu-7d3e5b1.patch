+                break;
+            }
             if (!ggml_is_inkling2_relbias(dst) || !ggml_cuda_inkling2_relbias_node_supported(dst)) {
                 return false;
             }
@@ -6810,7 +6814,8 @@ static bool ggml_backend_cuda_device_supports_op(ggml_backend_dev_t dev, const g
         case GGML_OP_DUP:
                 return true;
         case GGML_OP_CUSTOM:
-            return ggml_is_inkling2_relbias(op) && ggml_cuda_inkling2_relbias_node_supported(op);
+            return (ggml_is_inkling2_relbias(op) && ggml_cuda_inkling2_relbias_node_supported(op)) ||
+                   (ggml_is_inkling2_relbias_pos(op) && ggml_cuda_inkling2_relbias_pos_node_supported(op));
         case GGML_OP_ARGMAX:
         case GGML_OP_COUNT_EQUAL:
             return true;
