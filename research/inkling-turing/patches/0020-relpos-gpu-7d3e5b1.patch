+// ggml_inkling2_relbias_pos
+
+static const char ggml_inkling2_relbias_pos_tag = 0;
+
+static void ggml_inkling2_relbias_pos_cpu(struct ggml_tensor * dst, int ith, int nth, void * userdata) {
+    GGML_UNUSED(userdata);
+
+    const struct ggml_tensor * tab  = dst->src[0];
+    const struct ggml_tensor * s    = dst->src[1];
+    const struct ggml_tensor * cell = dst->src[2];
+    const struct ggml_tensor * tok  = dst->src[3];
+    const struct ggml_tensor * mask = dst->src[4];
+
+    const int64_t n_rows = tab->ne[0];
+    const int64_t n_head = tab->ne[1];
+    const int64_t n_tok  = tab->ne[2];
+    const int64_t n_kv   = cell->ne[0];
+    const int64_t extent = n_rows - 1;
+
+    const int32_t * cp = (const int32_t *) cell->data;
+    const int32_t * tp = (const int32_t *) tok->data;
+
+    for (int64_t t = ith; t < n_tok; t += nth) {
+        for (int64_t h = 0; h < n_head; ++h) {
+            const float * tb = (const float *) ((const char *) tab->data + h*tab->nb[1] + t*tab->nb[2]);
+            const float   sv = *(const float *) ((const char *) s->data + h*s->nb[1] + t*s->nb[2]);
+            for (int64_t kv = 0; kv < n_kv; ++kv) {
+                const int64_t dist = (int64_t) tp[t] - cp[kv];
+                const int64_t d    = cp[kv] >= 0 && dist >= 0 && dist < extent ? dist : extent;
+                const float m = mask->type == GGML_TYPE_F16 ?
+                    GGML_FP16_TO_FP32(((const ggml_fp16_t *) ((const char *) mask->data + t*mask->nb[1]))[kv]) :
+                    ((const float *) ((const char *) mask->data + t*mask->nb[1]))[kv];
+                const float b = tb[d] - sv;
+                const float v = b + m;
+                char * out = (char *) dst->data + ((h*n_tok + t)*n_kv + kv)*ggml_type_size(dst->type);
+                if (dst->type == GGML_TYPE_F16) {
+                    *(ggml_fp16_t *) out = GGML_FP32_TO_FP16(v);
+                } else {
+                    *(float *) out = v;
+                }
+            }
+        }
+    }
+}
+
+struct ggml_tensor * ggml_inkling2_relbias_pos(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * tab,
+        struct ggml_tensor  * sinks,
+        struct ggml_tensor  * cell,
+        struct ggml_tensor  * tok,
+        struct ggml_tensor  * mask,
+        enum ggml_type        type) {
+    GGML_ASSERT(tab->type == GGML_TYPE_F32 && tab->nb[0] == sizeof(float) && tab->ne[3] == 1);
+    GGML_ASSERT(sinks->type == GGML_TYPE_F32 && sinks->ne[0] == 1 && sinks->ne[1] == tab->ne[1] && sinks->ne[2] == tab->ne[2] && sinks->ne[3] == 1);
+    GGML_ASSERT(cell->type == GGML_TYPE_I32 && ggml_is_contiguous(cell) && cell->ne[1] == 1 && cell->ne[2] == 1 && cell->ne[3] == 1);
+    GGML_ASSERT(tok->type == GGML_TYPE_I32 && ggml_is_contiguous(tok) && tok->ne[0] == tab->ne[2] && tok->ne[1] == 1 && tok->ne[2] == 1 && tok->ne[3] == 1);
+    GGML_ASSERT(mask->type == GGML_TYPE_F16 || mask->type == GGML_TYPE_F32);
+    GGML_ASSERT(mask->ne[0] == cell->ne[0] && mask->ne[1] == tab->ne[2] && mask->ne[2] == 1 && mask->ne[3] == 1);
+    GGML_ASSERT(type == GGML_TYPE_F16 || type == GGML_TYPE_F32);
+
+    struct ggml_tensor * args[5] = { tab, sinks, cell, tok, mask };
+    return ggml_custom_4d(ctx, type, cell->ne[0], tab->ne[2], tab->ne[1], 1, args, 5, ggml_inkling2_relbias_pos_cpu,
+            GGML_N_TASKS_MAX, (void *) &ggml_inkling2_relbias_pos_tag);
+}
+
+bool ggml_is_inkling2_relbias_pos(const struct ggml_tensor * t) {
+    if (t->op != GGML_OP_CUSTOM) {
+        return false;
+    }
+    struct ggml_custom_op_params p;
+    memcpy(&p, t->op_params, sizeof(p));
+    return p.userdata == (void *) &ggml_inkling2_relbias_pos_tag;
+}
+
 struct ggml_tensor * ggml_custom_inplace(
         struct ggml_context * ctx,
         struct ggml_tensor  * a,
