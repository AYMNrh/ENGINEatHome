+
+// ---- the mask from positions (ggml_inkling2_relbias_pos) ---------------------------------------------------------------------
+bool ggml_cuda_inkling2_relbias_pos_node_supported(const ggml_tensor * dst) {
+    const ggml_tensor * tab  = dst->src[0];
+    const ggml_tensor * s    = dst->src[1];
+    const ggml_tensor * cell = dst->src[2];
+    const ggml_tensor * tok  = dst->src[3];
+    const ggml_tensor * mask = dst->src[4];
+    if (!tab || !s || !cell || !tok || !mask) {
+        return false;
+    }
+    const int64_t n_rows = tab->ne[0];
+    const int64_t n_head = tab->ne[1];
+    const int64_t n_tok  = tab->ne[2];
+    const int64_t n_kv   = cell->ne[0];
+    return inkling2_is_f32_rows(tab) && tab->ne[3] == 1 &&
+        s->type == GGML_TYPE_F32 && ggml_is_contiguous(s) && s->ne[0] == 1 && s->ne[1] == n_head && s->ne[2] == n_tok && s->ne[3] == 1 &&
+        cell->type == GGML_TYPE_I32 && ggml_is_contiguous(cell) && cell->ne[1] == 1 && cell->ne[2] == 1 &&
+        tok->type == GGML_TYPE_I32 && ggml_is_contiguous(tok) && tok->ne[0] == n_tok && tok->ne[1] == 1 &&
+        (mask->type == GGML_TYPE_F16 || mask->type == GGML_TYPE_F32) && mask->nb[0] == ggml_type_size(mask->type) &&
+        mask->ne[0] == n_kv && mask->ne[1] == n_tok && mask->ne[2] == 1 && mask->ne[3] == 1 &&
+        (dst->type == GGML_TYPE_F16 || dst->type == GGML_TYPE_F32) && ggml_is_contiguous(dst) &&
+        dst->ne[0] == n_kv && dst->ne[1] == n_tok && dst->ne[2] == n_head && dst->ne[3] == 1 &&
+        n_kv <= INT_MAX && n_rows <= INT_MAX && n_rows >= 2 && n_tok <= 65535 && n_head <= 65535;
+}
+
+void ggml_cuda_inkling2_relbias_pos_node(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    ggml_cuda_inkling2_args args;
+    args.type    = GGML_CUDA_INKLING2_RELBIAS;
+    args.n_nodes = 1;
+    args.dst     = dst;
+    args.src[0]  = dst->src[0];
+    args.src[1]  = dst->src[1];
+    args.src[2]  = dst->src[2]; // the cell positions
+    args.src[3]  = dst->src[4]; // the mask
+    args.node[0] = dst->src[3]; // the token positions
+    inkling2_relbias(ctx, args);
+}
