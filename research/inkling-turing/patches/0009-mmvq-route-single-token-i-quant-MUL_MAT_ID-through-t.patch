From e080dc0d2365d3c5de2f8de718c74919d3cce246 Mon Sep 17 00:00:00 2001
From: kernel-experiments <kernel-experiments@localhost>
Date: Sat, 21 Nov 2026 21:22:18 +0100
Subject: [PATCH 09/17] mmvq: route single-token i-quant MUL_MAT_ID through the
 warp-per-row MoE kernel

The generic ncols_dst == 1 kernel ends every row block with a shared-memory reduction. For the IQ2_S/IQ3_XXS
gate/up banks of Inkling 2 the warp-per-row MoE kernel is 19% faster on an RTX 2080 Ti (IQ3_XXS 102 -> 82 us,
Nsight Compute); for the NVFP4 down banks it is not (44.5 -> 47.7 us, latency bound once the barrier is gone),
so those stay on the stock kernel. GGML_CUDA_INK_T_MOE1 selects 0 stock / 1 down banks / 2 all / 3 i-quants (default).
Numerics: different summation order; MUL_MAT_ID tests pass, greedy decode equal on 3 of 4 prompts, logprob
deltas up to 6.5e-2 through the q8_0 KV rounding. GGML_CUDA_INK_T_MOE1=0 restores bit-exact decode.
Acceptance (3 reps, all optimizations vs same-session control): tg128 0K 56.79 -> 63.68, 8K 53.04 -> 57.35.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-cuda/mmvq.cu | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-cuda/mmvq.cu b/ggml/src/ggml-cuda/mmvq.cu
index 59161a4..e4a1e28 100644
--- a/ggml/src/ggml-cuda/mmvq.cu
+++ b/ggml/src/ggml-cuda/mmvq.cu
@@ -1284,7 +1284,21 @@ static void mul_mat_vec_q_switch_ncols_dst(
         return idle * 8 <= iters_wide * 2;
     };
 
-    if (has_ids && ncols_dst > 1) {
+    // turing-iq3-opt: single-token MUL_MAT_ID through the warp-per-row MoE kernel (no shared-memory reduction).
+    // Measured on an RTX 2080 Ti with Inkling 2 Mini: the IQ gate/up banks run 19% faster this way (IQ3_XXS 102 -> 82 us,
+    // Nsight Compute), the NVFP4 down banks do not (44.5 -> 47.7 us: without the barrier they are latency bound, a
+    // K = 1152 row is ~650 bytes). GGML_CUDA_INK_T_MOE1: 0 = stock, 1 = down-bank types, 2 = all types,
+    // 3 = i-quant types (default).
+    static const int moe1 = [] {
+        const char * env = getenv("GGML_CUDA_INK_T_MOE1");
+        return env ? atoi(env) : 3;
+    }();
+    const bool is_iq = type == GGML_TYPE_IQ2_XXS || type == GGML_TYPE_IQ2_XS || type == GGML_TYPE_IQ2_S ||
+                       type == GGML_TYPE_IQ3_XXS || type == GGML_TYPE_IQ3_S;
+    const bool moe1_type = moe1 == 2 || (moe1 == 3 && is_iq) ||
+        (moe1 == 1 && (type == GGML_TYPE_NVFP4 || type == GGML_TYPE_IQ4_NL || type == GGML_TYPE_Q5_0));
+
+    if (has_ids && (ncols_dst > 1 || moe1_type)) {
         // Multi-token MUL_MAT_ID path - dedicated MoE kernel
         mul_mat_vec_q_moe_launch<type>(
             vx, vy, ids, fusion, dst, ncols_x, nchannels_y_fd, nrows_x,
